{
  "name": "temin360-monorepo",
  "version": "1.0.0-rc.3",
  "private": true,
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter app-desktop dev",
    "dev:web": "pnpm --filter app-web dev",
    "dev:website": "pnpm --filter app-landing dev",
    "dev": "pnpm dev:desktop",
    "analyze": "node scripts/analyze-codebase.mjs",
    "db:up": "docker compose up -d db pocketbase minio",
    "db:down": "docker compose down",
    "services:up": "docker compose up -d pocketbase minio",
    "minio:up": "docker compose up -d minio",
    "minio:down": "docker compose stop minio",
    "pb:up": "node scripts/start-pocketbase.js",
    "pb:docker": "docker compose up -d pocketbase",
    "pb:down": "docker compose stop pocketbase",
    "prisma:generate": "pnpm --filter app-web prisma:generate",
    "prisma:push": "pnpm --filter app-web prisma:push",
    "prisma:seed": "pnpm --filter app-web prisma:seed",
    "prisma:studio": "pnpm --filter app-web prisma:studio",
    "build:desktop": "pnpm --filter app-desktop build",
    "build:web": "pnpm --filter app-web build",
    "build:website": "pnpm --filter app-landing build",
    "check:schema": "node scripts/check-schema.mjs",
    "fix:schema": "node scripts/check-schema.mjs --fix",
    "pre-release": "node scripts/check-schema.mjs --fix && pnpm --filter app-desktop typecheck:web",
    "typecheck:desktop": "pnpm --filter app-desktop typecheck",
    "typecheck:web": "pnpm --filter app-web build",
    "typecheck": "pnpm typecheck:desktop && pnpm typecheck:web",
    "test": "pnpm --filter app-desktop test",
    "test:watch": "pnpm --filter app-desktop test:watch",
    "test:e2e": "pnpm --filter app-desktop test:e2e",
    "format": "pnpm --filter app-desktop format",
    "lint": "pnpm --filter app-desktop lint && pnpm --filter app-web lint",
    "stats:loc": "pnpm --filter app-desktop stats:loc",
    "stats:loc:app": "pnpm --filter app-desktop stats:loc:app",
    "stats:loc:repo": "pnpm --filter app-desktop stats:loc:repo",
    "rebuild:electron": "npx @electron/rebuild -v 39.8.10 -f -w better-sqlite3",
    "release": "node apps/app-desktop/scripts/release.js",
    "release:rc": "node apps/app-desktop/scripts/release.js --rc",
    "release:patch": "node apps/app-desktop/scripts/release.js --patch",
    "release:local": "node apps/app-desktop/scripts/release.js --no-push",
    "release:patch:local": "node apps/app-desktop/scripts/release.js --patch --no-push",
    "release:publish": "node apps/app-desktop/scripts/release.js --patch && pnpm --filter app-desktop build:win",
    "release:exe": "pnpm release:publish",
    "release:dry": "node apps/app-desktop/scripts/release.js --dry-run",
    "release:rc:patch": "node apps/app-desktop/scripts/release.js --rc --patch",
    "release:rc:local": "node apps/app-desktop/scripts/release.js --rc --no-push",
    "release:rc:patch:local": "node apps/app-desktop/scripts/release.js --rc --patch --no-push",
    "release:rc:publish": "node apps/app-desktop/scripts/release.js --rc --patch && pnpm --filter app-desktop build:win",
    "release:rc:exe": "pnpm release:rc:publish",
    "release:rc:dry": "node apps/app-desktop/scripts/release.js --rc --dry-run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
